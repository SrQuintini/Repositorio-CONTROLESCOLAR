# Copia este archivo como .env y ajusta lo que necesites.

SECRET_KEY=cambia-esta-clave

# Base de datos. Si no pones nada, usa SQLite (archivo escuela.db).
# Para usar el MySQL de Laragon, crea la base "control_escolar" y descomenta:
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/control_escolar

# Correos reales (opcional). Con Gmail usa una "contraseña de aplicación".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
